{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Frontend",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/frontend",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "name": "Backend FastAPI",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--host",
                "localhost",
                "--port",
                "8000",
                "--log-level",
                "debug"
            ],
            "cwd": "${workspaceFolder}/backend/app",
            "envFile": "${workspaceFolder}/backend/.env",
            "justMyCode": true,
            "console": "integratedTerminal",
            "jinja": true
        },
        {
            "name": "Backend FastAPI (No Reload)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--host",
                "localhost",
                "--port",
                "8000",
                "--reload",
                "--log-level",
                "debug"
            ],
            "cwd": "${workspaceFolder}/backend/app",
            "envFile": "${workspaceFolder}/backend/.env",
            "justMyCode": true,
            "console": "integratedTerminal",
            "jinja": true
        }
    ],
    "compounds": [
        {
            "name": "Full Stack Debug",
            "configurations": [
                "Backend FastAPI (No Reload)",
                "Frontend"
            ],
            "stopAll": true
        }
    ]
}